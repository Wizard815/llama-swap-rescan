# Deploy config for the modelscan fork on RaidLab.
#
# Copy it over the live file once:
#
#   cp deploy/config.yaml deploy/config.yaml.bak
#   cp deploy/config.yaml.example deploy/config.yaml
#   docker restart llama-swap
#
# deploy/config.yaml is gitignored (it is the live file, holding this box's real
# paths), so `git pull` never updates it -- re-copy or merge this file by hand
# when the tuning here changes.
#
# FIRST APPLICATION TAKES TWO STEPS. The routing groups name models that only
# exist once the new modelScan groups below have run, and llama-swap refuses to
# start while a group names a model it has no config for:
#
#   ERROR creating group router: no model config for "..."
#
# So apply it in this order:
#
#   1. start with the `routing:` block removed (leave it commented out), then
#        curl -X POST http://192.168.20.5:8642/api/models/rescan
#      Run it again if /app/config.d/models.gpu1.generated.yaml or
#      models.embeddings.generated.yaml have not appeared -- one listing or
#      rescan does not always finish every group. Confirm the scan is clean:
#        cd /mnt/user/appdata/llamaswap/deploy/config.d
#        grep -hE '^  [a-z0-9]' models.*.generated.yaml | sort | uniq -d
#      Printed names are models two groups both claimed; that fails the config
#      load and must be fixed before continuing.
#   2. add the `routing:` block back and restart. From then on one restart is
#      enough, because the generated fragments stay on disk.
#
# The group members were checked against the GGUF files actually present in
# /app/models. The five gemma4-coding-* models an earlier draft listed are not
# there any more, and a member with no model config blocks startup completely,
# so they are deliberately not listed below; re-add them with the files.
#
# Requires the modelscan `env:`/`ttl:` extension in internal/modelscan/scan.go
# (commit 65b3100, on main). An unpatched binary ignores both keys and falls
# back to the plain cmdTemplate for every model -- it still loads, you just lose
# per-model device pinning and the keep-resident flags.
healthCheckTimeout: 300
# WAS 120. Your log shows `starting ornith-1.0-35b-a3b-... failed: health check
# timed out after 2m0s` -- llama-swap was killing models that were still
# loading. 300s is a working load plus margin.

# modelTogglesFile remembers each model's GPU mode chosen in the model detail
# view: standard (run the effective launch as written -- the default and the
# opt-out), single_gpu (bind to a card with enough free VRAM) or multi_model
# (one instance per GPU, ceil(chats/parallel)). It must live in the config.d
# mount so it survives reloads and container recreates. Leave it unset and the
# detail-view control is hidden and every model stays standard.
modelTogglesFile: /app/config.d/model_toggles.json

globalTTL: 900

logLevel: info

logToStdout: both
# WAS unset. Unset/empty behaves as `proxy`, which routes the upstream
# llama-server log to io.Discard: it is kept in memory for the GUI's viewer but
# never written to stdout, so it never reaches `docker logs` and therefore never
# reaches Unraid's /logterminal/llama-swap.log/. `both` = proxy + upstream.
# Source: internal/server/log.go NewLoggers().

# -c is the context window llama-server allocates for every launch that uses this
# macro, and the whole KV cache for it is allocated at load.
#
# This macro feeds the PRIMARY scan only, which claims the models that need both
# cards (the 35B-119B classes in the `heavy` routing group). They never coexist
# with anything -- heavy is swap+exclusive -- so a large window costs load time
# and VRAM, not concurrency. Size it for the longest conversation you actually
# run: at 32768 an agent session was rejected with
#
#   request (175224 tokens) exceeds the available context size (32768 tokens)
#
# 262144 is the window these sessions were sized against before. 131072 is a fair
# trade if you also let the client compact (Hermes: compression.enabled) instead
# of sending the whole history.
#
# The small models do not use this macro: every modelScan group below carries its
# own -c (search12b and MTP at 16384, embeddings at 8192), which is what lets them
# coexist on one card.
macros:
  rocm-llama-server: >
    llama-server --host 0.0.0.0 --port ${PORT}
    -ngl 99 -c 262144
    --flash-attn on
    --cache-type-k q8_0 --cache-type-v q8_0
    -lm dio
    --split-mode layer --jinja

  # --fit off was REMOVED. fit_params defaults to true (common/common.h:482)
  # and --fit off disabled the auto-fitting that shrinks unset args when a
  # layout does not fit. Combined with one large -c applied to every model it is
  # what made a 2B model allocate the same KV as a 35B one, on both cards, on
  # every load -- most of why two models could not coexist, and most of why each
  # swap cost so much. With --fit on, the window below only has to be honest
  # about the heavy models, which is why the small ones are peeled into their own
  # scan groups with their own -c.
  #
  # -lm dio is REQUIRED on this stack. FEATURES.md: "Always pass -lm dio
  # (--load-mode dio). mmap on the model file hangs on this stack." Your macro
  # did not pass it. If you have seen loads hang or never finish, this is the
  # first thing to fix.

modelScan:
  enabled: true
  dirs:
    - /app/models
  outputFile: /app/config.d/models.generated.yaml
  # Everything not claimed by a group below gets BOTH cards in layer mode --
  # the right default for the 30B-119B models.
  cmdTemplate: >
    ${rocm-llama-server} -m ${MODEL_PATH}

  # ---------------------------------------------------------------------------
  # Scan-group patterns MUST NOT OVERLAP.
  #
  # A group's `match` is only excluded from the *primary* scan
  # (internal/server/modelscan_api.go collects groupMatches into the primary's
  # ExcludePatterns and nothing else). Two groups matching the same file emit
  # the same model ID into two generated files, and llama-swap's config-dir
  # merge rejects duplicate model names -- which fails the whole config load.
  #
  # So when you peel a model out into its own group, remove its pattern from the
  # broader group it came from. Verify after every rescan:
  #
  #   cd /mnt/user/appdata/llamaswap/deploy/config.d
  #   grep -hE '^  [a-z0-9]' models.*.generated.yaml | sort | uniq -d
  #
  # Empty output = no duplicates. Anything printed is a model two groups both
  # claimed, and llama-swap will refuse the config until you fix it.
  # ---------------------------------------------------------------------------
  groups:
    # ---- the 12B quick-search model: small context, pinned, always resident ---
    # You asked for 12K-20K instead of 262144. 16384 with --fit on means it
    # loads fast and holds little VRAM, so it never queues behind anything.
    # ttl: 0 is what actually keeps it in memory -- see the note on the
    # `services` routing group below for why persistent alone is not enough.
    #
    # Pattern `gemma-4-12b-it-ud` deliberately does NOT match the MTP model
    # below (that file is `mtp-gemma-4-12b-it-q8_0` -- no `-ud`).
    - match: "gemma-4-12b-it-ud"
      dirs:
        - /app/models
      env:
        # Pinning by device *visibility* is more airtight than --main-gpu: with
        # only one device visible, llama.cpp cannot pick the other one at all.
        - "HIP_VISIBLE_DEVICES=0"
      ttl: 0
      cmdTemplate: >
        llama-server --host 0.0.0.0 --port ${PORT}
        -ngl 99 -c 16384 --flash-attn on
        --cache-type-k q8_0 --cache-type-v q8_0
        -lm dio --split-mode none --jinja
        -m ${MODEL_PATH}
      outputFile: /app/config.d/models.search12b.generated.yaml

    # ---- the one model that wants MTP speculative decoding ----
    # This is the "add -spec-type draft-mtp to just this model" case. Your own
    # config note says it must not go in the shared macro, because it is
    # architecture-specific to the MTP variant and would break the other ~25.
    - match: "mtp-gemma"
      dirs:
        - /app/models
      env:
        - "HIP_VISIBLE_DEVICES=0"
        # Per-model env, which is what you asked for. This flag is only
        # meaningful for the model that actually has an MTP head, so setting it
        # container-wide is noise on the other 30 models. (The self-build image
        # also bakes it in globally; an explicit entry here wins.)
        - "LLAMA_ENABLE_MTP_OPT=1"
      cmdTemplate: >
        llama-server --host 0.0.0.0 --port ${PORT}
        -ngl 99 -c 16384 --flash-attn on
        --cache-type-k q8_0 --cache-type-v q8_0
        -lm dio --split-mode none --jinja
        --spec-type draft-mtp --spec-draft-n-max 3
        -m ${MODEL_PATH}
      outputFile: /app/config.d/models.mtp.generated.yaml

    # ---- GPU 0: small dense models ----
    # Note this no longer contains `12b-it` or `mtp`: both moved into the two
    # groups above, and leaving them here would double-claim those files.
    - match: "(e2b|e4b|qwen3\\.5-2b|qwen2\\.5-3b|bonsai-8b|hermes-4-14b|hermes-q4_k_m|hermes-tools)"
      dirs:
        - /app/models
      env:
        - "HIP_VISIBLE_DEVICES=0"
      cmdTemplate: >
        llama-server --host 0.0.0.0 --port ${PORT}
        -ngl 99 -c 32768 --flash-attn on
        --cache-type-k q8_0 --cache-type-v q8_0
        -lm dio --split-mode none --jinja
        -m ${MODEL_PATH}
      outputFile: /app/config.d/models.gpu0.generated.yaml

    # ---- GPU 1: one-card mid models ----
    - match: "(gemma4-coding|31b-it|27b-ud)"
      dirs:
        - /app/models
      env:
        - "HIP_VISIBLE_DEVICES=1"
      cmdTemplate: >
        llama-server --host 0.0.0.0 --port ${PORT}
        -ngl 99 -c 32768 --flash-attn on
        --cache-type-k q8_0 --cache-type-v q8_0
        -lm dio --split-mode none --jinja
        -m ${MODEL_PATH}
      outputFile: /app/config.d/models.gpu1.generated.yaml

    # ---- embeddings: tiny, pinned, never unloaded ----
    # ttl: 0 is the real "always resident" switch -- this model is never a TTL
    # unload candidate. Combined with the persistent routing group below, the
    # embeddings survive a 35B model loading on top of them.
    - match: "nomic-embed"
      dirs:
        - /app/models
      env:
        - "HIP_VISIBLE_DEVICES=0"
      ttl: 0
      cmdTemplate: >
        llama-server --host 0.0.0.0 --port ${PORT}
        -ngl 99 -c 8192 --embedding --pooling mean
        -lm dio --split-mode none
        -m ${MODEL_PATH}
      outputFile: /app/config.d/models.embeddings.generated.yaml

# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------
# Out of the box llama-swap runs ONE model at a time, instance-wide (the
# implicit default group is swap: true + exclusive: true), so requesting model B
# unloads model A. Two prompts on the *same* model are fine -- those are two
# slots of one process -- but alternating models thrashes: unload A, load B,
# unload B, load A, with a multi-GB GGUF re-read each time. That is the 10x.
#
#   swap       true = one member at a time;  false = members coexist
#   exclusive  true = loading a member unloads every OTHER group
#   persistent true = no other group can ever unload this one
#
# Also verified in the source (internal/router/group.go:93, base.go:387-390):
#   - `persistent` only stops other groups from *choosing* these as eviction
#     targets. It is not a residency guarantee: a TTL unload, a manual
#     POST /api/models/unload, or the group's own swap rule still stops them.
#     That is why the embeddings and the 12B also carry `ttl: 0` above -- the
#     two flags do different jobs and you want both.
#   - Nothing anywhere waits for an in-flight request. Unload "does not wait
#     for in-flight requests"; Stop kills the upstream and the caller sees an
#     error. So there is no "finish the embeds first, then free the memory"
#     behaviour to rely on. Keeping the small models resident is the only way
#     to avoid that.
routing:
  router:
    use: group
    settings:
      groups:
        gpu0:
          swap: false          # members can be loaded together
          exclusive: false     # loading one does not evict other groups
          members:
            - bonsai-8b-q1_0
            - gemma-4-e2b-it-ud-q5_k_xl
            - gemma-4-e4b-it-q4_k_m
            - gemma-4-hermes-q4_k_m
            - gemma4-hermes-tools-q4_k_m
            - mtp-gemma-4-12b-it-q8_0
            - nousresearch_hermes-4-14b-q4_k_m
            - nousresearch_hermes-4-14b-q8_0
            - qwen2.5-3b-instruct-q4_k_m
            - qwen3.5-2b-q4_k_m

        gpu1:
          swap: false
          exclusive: false
          members:
            - gemma-4-31b-it-qat-ud-q4_k_xl
            - qwen3.6-27b-ud-q4_k_xl
            - qwen3.8-27b-ud-q6_k_xl

        heavy:
          swap: true           # one at a time among themselves
          exclusive: true      # loading one evicts gpu0 and gpu1 -- correct,
                               # they need both cards
          members:
            - hermes-4_3_36b-q8_0
            - hermes-4_3_36b-q8_0-hermes-4_3_36b-q8_0-1
            - mistral-small-4-119b-2603-ud-q3_k_xl-00001-of-00003
            - mistral-small-4-119b-2603-ud-q3_k_xl-00002-of-00003
            - mistral-small-4-119b-2603-ud-q3_k_xl-00003-of-00003
            - ornith-1.0-35b-a3b-mxfp4_moe_q8_0_f16-imatrix
            - qwen3.6-35b-a3b-ud-q4_k_m
            - qwen3.6-35b-a3b-ud-q4_k_m-5bc3e238d916f48a861bac2f8a1990a0e9b7e98d-1
            - qwen3.6-35b-a3b-ud-q4_k_xl
            - qwen3.6-35b-a3b-ud-q6_k_xl
            - qwen3.6-35b-a3b-ud-q8_k_xl
            - qwen3vl-30b-a3b-thinking-q4_k_m

        # The documented pattern: "one exclusive group for the big LLMs and one
        # non-exclusive group for small always-useful models like embeddings and
        # rerankers."
        #
        # Your whisper + embeddings + ornith case lives here. heavy.exclusive
        # cannot evict these, so loading a 35B MoE leaves your search model and
        # embeddings still answering.
        #
        # whisper is deliberately absent: this image has llama-server only, no
        # whisper-server, so there is no model ID to list. kokoro-fastapi and
        # your Whisper_server user script are outside llama-swap entirely and
        # llama-swap cannot evict them -- pin those with HIP_VISIBLE_DEVICES in
        # their own compose so they do not land on a card a heavy model needs.
        services:
          persistent: true     # heavy.exclusive cannot unload these
          swap: false          # all members coexist
          exclusive: false     # loading one does not evict other groups
          members:
            - nomic-embed-text-v1.5.q8_0
            - nomic-embed-text-v2-moe.q8_0
            - gemma-4-12b-it-ud-q8_k_xl

# -----------------------------------------------------------------------------
# Odysseus integration
# -----------------------------------------------------------------------------
# Kept from the live config: llama-swap reads Odysseus' saved Cookbook configs
# and generates the per-model launch variants under /app/config.d/odysseus.generated.yaml,
# which is what the `ody` profile pins. The mount lives in docker-compose.yml;
# the state directory has to be traversable by this container's uid or every
# refresh logs "reading odysseus.stateFile ... permission denied" and the
# profiles never appear (GET /api/profiles reports active: null).
#   chmod 711 /mnt/user/appdata/odysseus/data
odysseus:
  enabled: true
  stateFile: "/app/odysseus-data/cookbook_state.json"
  refreshSeconds: 300
  profilePrefix: "ody"
  outputFile: "/app/config.d/odysseus.generated.yaml"
  ensureDio: true

# Copy this to .env (same folder as docker-compose.yml) and fill in.

# Image built via: docker build -f docker/llama-swap-source.Containerfile -t llama-swap-modelscan:local ..
IMAGE_TAG=llama-swap-modelscan:local

# Host port to reach llama-swap on (container listens on 8080 internally).
LISTEN_PORT=8642

# Host paths — absolute paths on RaidLab.
MODELS_DIR=/mnt/user/OnePiece/HomeLab/LLMBin
CONFIG_FILE=/mnt/user/OnePiece/HomeLab/llamaswap/deploy/config.yaml
CONFIG_DIR=/mnt/user/OnePiece/HomeLab/llamaswap/deploy/config.d

# GPU device group GID — confirmed via `ls -la /dev/kfd /dev/dri` +
# `getent group video` on RaidLab: both /dev/kfd and every /dev/dri/* node
# are owned by group "video", GID 18. Using the raw number (not the name)
# since the image's /etc/group doesn't define "video" or "render" itself —
# compose's group_add accepts a numeric GID directly, skipping name
# resolution, so this works regardless of what the image calls it.
VIDEO_GID=18

# Copy this file to .env (same folder as docker-compose.yml) and fill in the
# values for your machine.
#
# Every path below is an example. Replace the /path/to/... placeholders with
# real absolute paths on the host that runs Docker -- .env is gitignored, so
# your real values never leave the box.

# Image built via:
#   docker build -f docker/llama-swap-source.Containerfile -t llama-swap-rescan:local .
IMAGE_TAG=llama-swap-rescan:local

# Host port to reach llama-swap on (the container listens on 8080 internally).
LISTEN_PORT=8642

# Host paths.
MODELS_DIR=/path/to/models              # mounted at /app/models, scanned for GGUFs
CONFIG_FILE=/path/to/llama-swap.yaml    # mounted at /app/config.yaml (read-only)
CONFIG_DIR=/path/to/config.d            # mounted at /app/config.d (read-write:
                                        # modelscan and the Odysseus integration
                                        # write generated fragments here)

# GPU device group GID. Find it with:
#   ls -la /dev/kfd /dev/dri && getent group video
# Use the numeric GID rather than the name: the image's /etc/group may not
# define "video" or "render", while compose's group_add accepts a raw number and
# skips name resolution.
VIDEO_GID=18

# Token shared with the Odysseus container -- the same value as
# ODYSSEUS_INTERNAL_TOKEN there. Only needed for the odysseus integration in
# config.yaml; leave it unset otherwise.
# ODYSSEUS_INTERNAL_TOKEN=
